// Adapter format 0.2 skeleton, following docs/core/locus-modder-design-2026-10-11.md §5.
// PROVISIONAL: every field name below is a design proposal until crates/locus-package 0.2 and
// docs/schemas/ hold the 0.2 schema. Before use: adapter_validate on a minimal file, then rename
// to what the validator accepts. Remove these comments; the shipped file is plain JSON.
// "<…>" marks a value to fill; "0x…" an address to find. Nothing game-derived goes in here:
// addresses, offsets, layouts, numbers and names only.
{
  "locus_adapter": "0.2",
  "id": "<game>-<character>",                       // e.g. jak1-jak
  "version": "0.1.0",
  "character": { "name": "<Character>", "game": "<Game title>" },

  // Step 0
  "source": {
    "platform": "<ps1|ps2>",
    "builds": [ { "id": "<SERIAL>", "fingerprints": [
      { "kind": "serial", "value": "<SERIAL>" },
      { "kind": "sha1", "value": "<image sha1>" },
      { "kind": "crc32", "value": "<boot ELF CRC>" }      // kinds beyond 0.1's are provisional
    ] } ]
  },
  "runtime": { "connector": "<pcsx2|duckstation>", "connector_min": "<version>",
               "tested_runtimes": [ { "name": "<PCSX2|DuckStation>", "version": "<version arch>" } ] },
  "profile": "live_bridge",

  // Steps 3-4: memory as typed fields (design §5.1, D1)
  "memory": {
    "regions": [ { "name": "<ee|ram>", "from": "0x…", "to": "0x…" } ],
    "fields": {
      "hero":        { "pointer": ["0x…", "+0x…"], "guard": { "u32_at": "+0x…", "equals": "0x…" } },
      "hero.pos":    { "at": "hero+0x…", "type": "<vec3_f32|vec3_i32>", "scale": 1.0 },
      "hero.facing": { "at": "hero+0x…", "type": "<f32|u16>", "turn": "<radians|4096>" },
      "hero.anim":   { "at": "hero+0x…", "type": "u16" },
      "hero.state":  { "at": "hero+0x…", "type": "u8" },
      "hero.health": { "at": "0x…", "type": "u32" },
      "lives":       { "at": "0x…", "type": "u32" },
      "frame":       { "at": "0x…", "type": "u32", "role": "frame_counter" },
      "level":       { "at": "0x…", "type": "u32" },
      "camera":      { "at": "0x…", "type": "mat4_f32", "layout": "<row_major|…>" }
    },
    "objects": { "table": { "at": "0x…", "stride": "0x…", "count": 0 },
                 "class": "+0x…", "state": "+0x…", "transform": "+0x…", "scale": "+0x…" }
  },

  // Code inside the console: hook templates only (design §5.2 hooks, D3). Names provisional.
  "hooks": [
    { "template": "copy_on_execute", "pc": "0x…", "source": { "reg": "<a0>", "offset": 0 },
      "bytes": 0, "slots": 2, "name": "pose_palette" },
    { "template": "pad_inject", "pc": "0x…", "socket": 0, "phase": "ready_state_only" }
  ],

  // Step 5 mapping (native = matrix × (LOCUS metres × scale) + offset; check direction with validate)
  "mapping": { "native_from_locus": { "matrix": [[1,0,0],[0,0,-1],[0,1,0]], "offset": [0,0,0], "scale": 1.0 },
               "crop": { "min": [0,0,0], "max": [0,0,0] } },

  // Step 13
  "ready_state": [
    { "boot": {} },
    { "until": { "field": "frame", "rises": true }, "timeout_s": 30 },
    { "press": ["<button>"], "when": { "field": "<menu field>", "equals": 0 } },
    { "until": { "field": "level", "equals": 0 } },
    { "install": ["world", "hooks", "silence"] },
    { "save_state": "ready" }
  ],

  // Steps 4, 5, 11
  "world": {
    "route": "<geometry_substitution|answer_hook>",
    "collision": { "format": "formats/<collision>.json", "root": "0x…", "capacity": 0, "grid": 0.0 },
    "silence": { "objects": "<freeze|free>", "keep_classes": [] },
    "foreign_bodies": { "proxy": "<object|collision_box>", "classes": [], "slots": [] },
    "after_swap": [ { "write": "hero+0x…", "value": -1 } ]
  },

  // Steps 6-8 (design §5.3 kinds)
  "presentation": {
    "model": { "capture": { "hook": "<decoded_vertices>", "layout": "formats/<upload>.json" },
               "or_format": "formats/<model>.json", "class": 0 },
    "pose": { "kind": "<skeleton|morph>", "from_hook": "pose_palette", "joints": 0 },
    "items": [ { "name": "<item>", "class": 0, "held_on_bone": 0, "free_when": { "field": "<item.state>", "in": [] } } ],
    "effects": [],
    "camera": { "kind": "<captured|locus>", "field": "camera" }
  },

  "input": { "device": "assigned", "hide_other_devices": true },

  // Steps 9-10 (0.1's entity and attacks, plus how damage is applied)
  "entity": {
    "body": { "capsule": { "a": [0.0, 0.3, 0.0], "b": [0.0, 0.8, 0.0], "radius": 0.3 } },
    "hurt": [ { "capsule": { "a": [0.0, 0.35, 0.0], "b": [0.0, 0.75, 0.0], "radius": 0.35 } } ],
    "health": { "unit": "ext.<game>.<unit>", "max": 0.0, "field": "hero.health" },
    "damage_table": { "light": 1.0, "medium": 1.0, "heavy": 2.0, "lethal": 0.0 },
    "respawn": "native",
    "apply_damage": [ { "<or_bits|ring_record>": { } } ],
    "keep": [ { "field": "lives", "at_least": 3 } ]
  },
  "attacks_off_when": [ { "field": "hero.health", "test": { "below": 1.0 } } ],
  "attacks": [
    { "kind": "ext.<game>.<attack>", "category": "melee", "tier": "light", "max_reach": 2.0,
      "approach": null, "on_landed": "none",
      "trigger": { "when": [ { "field": "hero.anim", "test": { "in": [] } } ], "unless": [],
                   "instance": { "per_value": { "field": "hero.anim" } } },
      "hitbox": { "anchor": { "bone": "<bone>" }, "shape": { "capsule": { "a": [0,0,0], "b": [0,0,0], "radius": 0.2 } },
                  "fallback": null } }
  ],

  // Step 12
  "sounds": { "table": { "at": "0x…", "slots": 0, "stride": "0x…",
                         "fields": { "sound": "+0x…", "state": "+0x…", "owner": "+0x…", "pos": "+0x…", "volume": "+0x…" },
                         "playing_states": [], "owner_is": ["hero"] },
              "samples": { "format": "formats/<bank>.json", "from": { "<disc|savestate>": "<where>" } },
              "names": { } },

  "tests": [ "tests/drop.json", "tests/stairs-0.25.json", "tests/dummy-<attack>.json", "tests/hurt-and-respawn.json" ],
  "evidence": [ { "claim": "<one claim>", "level": "<tested|research|inference|synthetic>", "record": "<sheet section>" } ]
}
